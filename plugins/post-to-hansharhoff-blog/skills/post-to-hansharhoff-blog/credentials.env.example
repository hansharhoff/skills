# Copy this file to `credentials.env` and fill in your values.
# `credentials.env` is gitignored — NEVER commit real credentials.

WP_SITE=https://hansharhoff.dk/blog
WP_USER=your-wordpress-username

# A WordPress Application Password: WP admin -> Users -> Profile -> Application Passwords.
# Choose ONE of the following for WP_APP_PW:

# (A) Paste it directly (spaces are fine — they're ignored):
WP_APP_PW=xxxx xxxx xxxx xxxx xxxx xxxx

# (B) No plaintext on disk — reference 1Password; resolved at runtime via the `op` CLI:
# WP_APP_PW=op://Private/hansharhoff-blog/credential

# You can also skip this file entirely and set WP_SITE / WP_USER / WP_APP_PW
# as environment variables instead (they take precedence over this file).
